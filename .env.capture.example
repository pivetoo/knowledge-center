# Credenciais usadas por `npm run capturas` para logar no Mainstay e fotografar as telas.
# Copie para .env.capture (ignorado pelo git) e preencha.
#
# Se este arquivo nao existir, o script reaproveita automaticamente o e2e/.env do
# AgencyCampaign.Web, que ja tem o mesmo usuario de captura.
E2E_BASE_URL=https://agencias.mainstay.com.br
E2E_USER=
E2E_PASSWORD=
